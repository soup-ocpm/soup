{
  "name": "soup-packages",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11"
  },
  "description": "SOUP packages: the @soup/sdk and the frontend bundles of every package with an app/ part",
  "contributors": [
    {
      "name": "Alessio Pianaroli",
      "email": "alessiopianaroli.it@gmail.com"
    }
  ],
  "workspaces": [
    "sdk",
    "_template/app",
    "*/app"
  ],
  "scripts": {
    "build:sdk": "tsc -p sdk",
    "build:packages": "node sdk/scripts/build-packages.mjs",
    "pack": "node sdk/scripts/pack.mjs",
    "lint": "eslint . --max-warnings=0 && knip && tsc -p sdk --noEmit",
    "typecheck": "tsc -p sdk --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fflate": "^0.8.2",
    "jsdom": "^30.1.3",
    "knip": "5.88.1",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
