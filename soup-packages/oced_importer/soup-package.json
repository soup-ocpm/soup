  ],
  "requires_tools": [
    "catalog",
    "storage"
  ],
  "provides_tools": [],
  "extension_points": [
    "oced.ocel_importers",
    "oced.memgraph_steps"
  ],
  "python_dependencies": [],
  "server": {
    "module": "server",
    "plugin": "plugin:Plugin"
  },
  "app": {
    "entry": "dist/index.js"
  }
}
