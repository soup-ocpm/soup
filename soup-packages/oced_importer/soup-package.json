{
  "name": "oced_importer",
  "version": "1.2.0",
  "api_version": "4.0",
  "label": "OCED event-log importer",
  "description": "Import OCED event/object CSV tables into dataset-scoped EKGs on Memgraph or Neo4j.",
  "databases": [
