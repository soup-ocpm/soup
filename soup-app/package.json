{
  "name": "soup-app",
  "version": "1.0.0",
  "description": "Official SOUP Application",
  "author": {
    "name": "Alessio Giacché",
    "email": "ale.giacc.dev@gmail.com"
  },
  "contributors": [
    {
      "name": "Sara Pettinari",
      "email": "sara.pettinari@gssi.it"
    },
    {
      "name": "Alessio Pianaroli",
      "email": "alessiopianaroli.it@gmail.com"
    }
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:v3": "ng test --watch=false",
    "e2e": "playwright test",
    "setup:server": "python ../soup-server/scripts/setup_venv.py",
    "lint": "ng lint --max-warnings=0 && knip && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.15.17",
    "angular-eslint": "21.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^30.1.3",
    "knip": "5.88.1",
    "prettier": "^3.3.3",
    "sass": "^1.79.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
